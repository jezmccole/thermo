pkgname=thermo
pkgver=0.1.0
pkgrel=2
pkgdesc='Modern ambient desktop edge thermometer for MacBook'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/thermo "$pkgdir/usr/bin/thermo"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/thermo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/thermo.svg"
  install -Dm644 "$startdir/thermo.desktop" "$pkgdir/usr/share/applications/thermo.desktop"
}
